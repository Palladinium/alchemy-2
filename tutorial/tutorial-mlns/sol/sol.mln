person = { Alice, Bob, Charlie }

Thinks(person, $)
Smokes(person)
Friends(person, person)

// People think what they know about themselves
Smokes(a) => Thinks(a, $Smokes(a)).

// Friendships are symmetric and antireflexive
!Friends(a, a).
Friends(a, b) <=> Friends(b, a).

// Friends tend to influence each other's habits
1.0 (Friends(a, b) ^ Thinks(a, $Smokes(b))) => Smokes(a)

// People typically don't smoke
0.1 !Smokes(a)

