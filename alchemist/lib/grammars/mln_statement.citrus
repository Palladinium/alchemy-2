grammar MLNStatement
  include Alchemist::Grammars::Logic
  include Alchemist::Grammars::Common

  ## Root

  rule statement
    comment
    | type_decl
    | weighted_rule
    | strong_rule
    | pred_decl
  end

  ## Nonterminals

  rule type_decl
    (type_name space* '=' space* '{' (space* values:int space* ','? space*)* '}') {
      Alchemist::Logic::TypeDecl.new(capture(:type_name).value, captures(:values).map { |v| Alchemist::Logic::ConstantDecl.new(v.value) })
    }

    | (type_name space* '=' space* '{' space* start:int space* ',' space* '...' space* ',' space* end:int space* '}') {
      Alchemist::Logic::TypeDecl.new(capture(:type_name).value, ((capture(:start).value)..(capture(:end).value)).map { |v| Alchemist::Logic::ConstantDecl.new(v) }.to_a)
    }

    | (type_name space* '=' space* '{' (space* values:constant space* ','? space*)* '}') {
      Alchemist::Logic::TypeDecl.new(capture(:type_name).value, captures(:values).map(&:value))
    }
  end

  rule pred_decl
    (pred_name space* ('(' space* (args:arg_decl space* ','? space*)* space* ')')?) {
      Alchemist::Logic::PredicateDecl.new(capture(:pred_name).value, captures(:args).map(&:value))
    }
  end

  rule arg_decl
    (type_name space* blocking:'!'?) {
      Alchemist::Logic::ArgDecl.new(capture(:type_name).value, capture(:blocking).nil?)
    }

    | ('$' space* blocking:'!'?) {
      Alchemist::Logic::ArgDecl.new(Alchemist::Logic::SOL_TYPE, capture(:blocking).nil?)
    }
  end

  rule weighted_rule
    (weight:float space* sentence) { Alchemist::MLN::MLNRuleDecl.new(capture(:sentence).value, capture(:weight).value) }
  end

  rule strong_rule
    (sentence space* '.') { Alchemist::MLN::MLNRuleDecl.strong(capture(:sentence).value) }
  end

  rule arg
    sol_atom
    | variable
    | constant
  end
end
