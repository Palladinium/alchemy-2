module Alchemizer
  module Grammars
    grammar DB
      include Alchemizer::Grammars::Logic
      include Alchemizer::Grammars::Common

      rule db
        (line:db_line newline rest:db) {
          def value
           [line.value].compact + rest.value
          end
        }

        / (line:db_line) {
          def value
            [line.value].compact
          end
        }
      end

      rule db_line
        statement

        / (dummy:space*) {
          def value
            nil
          end
        }
      end

      rule statement
        comment

        / (a:atom) {
          def value
            [a.value, true]
          end
        }

        / '!' space* a:atom {
          def value
            [a.value, false]
          end
        }

        / '?' space* a:atom {
          def value
            [a.value, nil]
          end
        }
      end

      rule arg
        sol_atom
        / constant
      end
    end
  end
end