module Alchemizer
  module Grammars
    grammar MLN
      include Alchemizer::Grammars::Logic
      include Alchemizer::Grammars::Common

      ## Root

      rule mln
        (line:mln_line newline rest:mln) {
          def value
            [line.value].compact + rest.value
          end 
        }

        / (line:mln_line) {
          def value
            [line.value].compact
          end
        }
      end

      ## Nonterminals

      rule mln_line
        (space* statement space*) {
          def value
            statement.value
          end
        }

        / (dummy:space*) {
          def value
            nil
          end
        }
      end

      rule statement
        comment
        / type_decl
        / weighted_rule
        / strong_rule
        / pred_decl
      end
    
      rule type_decl
        (type_name space* '=' space* '{' type_decl_int_values '}') {
          def value
            Alchemizer::Logic::TypeDecl.new(type_name.text_value, type_decl_int_values.value)
          end
        }
    
        / (type_name space* '=' space* '{' space* start_val:int space* ',' space* '...' space* ',' space* end_val:int space* '}') {
          def value
            Alchemizer::Logic::TypeDecl.new(type_name.text_value, (start_val.value)..(end_val.value))
          end
        }
    
        / (type_name space* '=' space* '{' type_decl_constant_values '}') {
          def value
            Alchemizer::Logic::TypeDecl.new(type_name.text_value, type_decl_constant_values.value)
          end
        }
      end

      rule type_decl_int_values
        values:type_decl_int_value* {
          def value
            values.elements.map(&:value)
          end
        }
      end

      rule type_decl_int_value
        space* int space* ','? space* {
          def value
            Alchemizer::Logic::ConstantDecl.new(int.value)
          end
        }
      end

      rule type_decl_constant_values
        values:type_decl_constant_value* {
          def value
            values.elements.map(&:value)
          end
        }
      end

      rule type_decl_constant_value
        space* constant space* ','? space* {
          def value
            constant.value
          end
        }
      end

      rule pred_decl
        pred_name space* pred_decl_args_parens {
          def value
            Alchemizer::Logic::PredicateDecl.new(pred_name.text_value, pred_decl_args_parens.value)
          end
        }
      end

      rule pred_decl_args_parens
        ('(' space* args:pred_decl_arg* space* ')') {
          def value
            args.elements.map(&:value)
          end
        }

        / '' {
          def value
            []
          end
        }
      end

      rule pred_decl_arg
        arg_decl space* ','? space* {
          def value
            arg_decl.value
          end
        }
      end
 
      rule arg_decl
        (type_name space* blocking:'!'?) {
          def value
            Alchemizer::Logic::ArgDecl.new(type_name.text_value, !blocking.empty?)
          end
        }
    
        / ('$' space* blocking:'!'?) {
          def value
            Alchemizer::Logic::ArgDecl.new(Alchemizer::Logic::SOL_TYPE, !blocking.empty?)
          end
        }
      end
    
      rule weighted_rule
        (weight:float space* sentence) {
          def value
            Alchemizer::MLN::MLNRuleDecl.new(sentence.value, weight.value)
          end
        }
      end
    
      rule strong_rule
        (sentence space* '.') {
          def value
            Alchemizer::MLN::MLNRuleDecl.strong(sentence.value)
          end
        }
      end
    
      rule arg
        sol_atom

        / (lhs:num_arg space* '+' space* rhs:num_arg) {
          def value
            Alchemizer::Logic::Plus.new(lhs.value, rhs.value) 
          end
        }

        / (lhs:num_arg space* '-' space* rhs:num_arg) {
          def value
            Alchemizer::Logic::Minus.new(lhs.value, rhs.value) 
          end
        }

        / num_arg
      end

      rule num_arg
        variable
        / constant
      end  

    end
  end
end