module Alchemizer
  module Grammars
    grammar Result
      include Alchemizer::Grammars::Logic
      include Alchemizer::Grammars::Common

      rule result_file
        (line:result_line newline rest:result_file) {
          def value
            [line.value].compact + rest.value
          end
        }

        / (line:result_line) {
          def value
            [line.value].compact
          end
        }
      end

      rule result_line
        result

        / (dummy:space*) {
          def value
            nil
          end
        }
      end

      rule result
        (a:atom space+ v:(value?)) {
          def value
            [
              a.value,
              if v.empty?
                nil
              else
                v.value
              end
            ]
          end
        }
      end

      rule value
        (!(space / newline) .)+ {
          def value
            Float(text_value)
          end
        }
      end

      rule arg
        sol_atom
        / constant
      end
    end
  end
end