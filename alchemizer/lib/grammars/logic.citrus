grammar Logic
  include Common

  ## Nonterminals

  rule sentence
    quantified_sentence
  end

  rule quantified_sentence
    (quantifier space* quantified_sentence) { capture(:quantifier).value.new(capture(:quantified_sentence).value) }
    | iff_sentence
  end

  rule iff_sentence
    (implies_sentence space* '<=>' space* iff_sentence) { Alchemizer::Logic::IFF.new(capture(:implies_sentence).value, capture(:iff_sentence).value) }
    | implies_sentence
  end

  rule implies_sentence
    (or_sentence space* '=>' space* implies_sentence) { Alchemizer::Logic::Implies.new(capture(:or_sentence).value, capture(:implies_sentence).value) }
    | or_sentence
  end

  rule or_sentence
    (and_sentence space* 'v' space* or_sentence) { Alchemizer::Logic::Or.new(capture(:and_sentence).value, capture(:or_sentence).value) }
    | and_sentence
  end

  rule and_sentence
    (not_sentence space* '^' space* and_sentence) { Alchemizer::Logic::And.new(capture(:not_sentence).value, capture(:and_sentence).value) }
    | not_sentence
  end

  rule not_sentence
    ('(' space* sentence space* ')') { capture(:sentence).value }
    | ('!' space* not_sentence) { Alchemizer::Logic::Not.new(capture(:not_sentence).value) }
    | atom
  end

  rule atom
    (pred_name space* ('(' space* (args:arg space* ','? space*)* space* ')')?) {
      Alchemizer::Logic::AtomDecl.new(capture(:pred_name).value, captures(:args).map(&:value))
    }
  end

  rule sol_atom
    ('$' space* atom) { capture(:atom).value }
  end

  ## Terminals

  rule type_name
    /[a-z]\w*/
  end

  rule pred_name
    /[A-Z]\w*/
  end

  rule variable
    /[a-z]\w*/ { Alchemizer::Logic::VariableDecl.new(to_str) }
  end

  rule constant
    (/[0-9]+/) { Alchemizer::Logic::ConstantDecl.new(Integer(to_str)) }
    | (/[A-Z]\w*/) { Alchemizer::Logic::ConstantDecl.new(to_str) }
  end

  rule quantifier
    'forall' { Alchemizer::Logic::ForAll }
    | 'exists' { Alchemizer::Logic::Exists }
  end

  ## To be implemented by subgrammars
end